<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#14141A"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="BEATPAD"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <Button
            android:id="@+id/exportBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="EXPORT"
            android:textSize="12sp"
            android:backgroundTint="#2A2A32"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- transport -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/playBtn"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="52dp"
            android:text="PLAY"
            android:textStyle="bold"
            android:backgroundTint="#FF5C5C"
            android:textColor="#FFFFFF" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/clearBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="CLEAR"
            android:backgroundTint="#2A2A32"
            android:textColor="#FFFFFF" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/mixBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="MIX"
            android:backgroundTint="#2A2A32"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- pattern slots -->
    <LinearLayout
        android:id="@+id/slotRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical" />

    <!-- bpm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/bpmLabel"
            android:layout_width="86dp"
            android:layout_height="wrap_content"
            android:text="120 BPM"
            android:textColor="#CCCCCC"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/bpmSeek"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- swing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/swingLabel"
            android:layout_width="86dp"
            android:layout_height="wrap_content"
            android:text="SWING 0"
            android:textColor="#CCCCCC"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/swingSeek"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:id="@+id/trackLabels"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <com.sixzero.beatpad.SequencerView
            android:id="@+id/grid"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- mixer (hidden until MIX tapped) -->
    <LinearLayout
        android:id="@+id/mixer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tap cells • drag to paint • tap name = preview • hold name = mute • hold A-D = add to chain"
        android:textColor="#666666"
        android:textSize="11sp"
        android:layout_marginTop="8dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E0E12"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- header: title + kit chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEATPAD"
            android:textColor="#EDEDF2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.25" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/kitRow"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- transport -->
    <LinearLayout
        android:id="@+id/transport"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp" />

    <!-- slots -->
    <LinearLayout
        android:id="@+id/slotRow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp" />

    <!-- bpm / swing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/bpmLabel"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:text="120 BPM"
            android:textColor="#7A7A88"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <SeekBar
            android:id="@+id/bpmSeek"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:progressTint="#FF5C5C"
            android:thumbTint="#FF5C5C" />

        <TextView
            android:id="@+id/swingLabel"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingEnd="8dp"
            android:text="SWING 0"
            android:textColor="#7A7A88"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <SeekBar
            android:id="@+id/swingSeek"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:progressTint="#5CE1E6"
            android:thumbTint="#5CE1E6" />
    </LinearLayout>

    <!-- bars -->
    <LinearLayout
        android:id="@+id/barRow"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:layout_marginTop="4dp" />

    <!-- main area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:id="@+id/seqPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/trackLabels"
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:orientation="vertical" />

            <com.sixzero.beatpad.SequencerView
                android:id="@+id/grid"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent" />
        </LinearLayout>

        <com.sixzero.beatpad.PadsView
            android:id="@+id/pads"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/melodyPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/laneRow"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/scaleRow"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <com.sixzero.beatpad.PianoRollView
                android:id="@+id/roll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/mixPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/mixer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tap = hit • drag = paint • hold = accent • hold name = mute"
        android:textColor="#55555F"
        android:textSize="11sp"
        android:layout_marginTop="6dp" />

    <!-- bottom tabs -->
    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp" />
</LinearLayout>
